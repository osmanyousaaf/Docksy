{
  "name": "@crovenai/docksy-mcp",
  "version": "0.1.0",
  "description": "Docksy MCP server — let Claude deploy, monitor and fix your servers.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "docksy-mcp": "./dist/docksy-mcp.js"
  },
  "files": [
    "dist"
  ],
  "mcpName": "io.github.osmanyousaaf/docksy",
  "scripts": {
