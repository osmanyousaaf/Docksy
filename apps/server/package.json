{
  "name": "@docksy/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Docksy control plane: REST API, deploy engine, monitoring, alerts.",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/index.ts",
    "start": "node src/index.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test --test-reporter=spec \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "hono": "^4.13.16",
    "nodemailer": "^10.3.1",
    "ssh2": "^1.17.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.2",
    "@types/ssh2": "^1.15.6"
  }
}
